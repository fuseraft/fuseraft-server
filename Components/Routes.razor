<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <div class="page-header"><h1>Admins only</h1></div>
                <p class="muted">That page is for admins. Ask one if you need something there.</p>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found — Fuseraft</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="page-header"><h1>Not found</h1></div>
            <p class="muted">There's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>
