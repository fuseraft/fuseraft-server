@page "/configs"
@implements IDisposable
@inject ConfigService ConfigService
@inject WorkspaceService WorkspaceService

<PageTitle>Configs — Fuseraft</PageTitle>

<div class="page-header">
    <h1>Config Files</h1>
</div>

<div class="form-group" style="max-width:680px">
    <label class="form-label">Directory or File Path</label>
    <div class="input-with-btn">
        <input @bind="_path" @bind:event="oninput" class="input"
               placeholder="/path/to/project or /path/to/config.yaml" />
        <button class="btn btn-sm" @onclick="TogglePicker">Browse…</button>
        <button class="btn btn-sm btn-primary" @onclick="SearchAsync">Scan</button>
    </div>
    @if (_showPicker)
    {
        <DirPicker InitialPath="@_path" OnSelect="OnDirSelected" OnClose="() => _showPicker = false" />
    }
</div>

@if (_error is not null)
{
    <div class="error-banner">@_error</div>
}

@if (_scanning)
{
    <p class="muted">Scanning…</p>
}
else if (_configs is not null)
{
    @if (_configs.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">🗂</div>
            <p>No config files found.</p>
            <p class="muted">Only <code>.yaml</code>, <code>.yml</code>, and <code>.json</code> files are scanned.</p>
        </div>
    }
    else
    {
        <div class="table-wrapper" style="margin-bottom:1.5rem">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>File</th>
                        <th>Name</th>
                        <th>Agents</th>
                        <th>Selection</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cfg in _configs)
                    {
                        <tr class="@(_selected?.Path == cfg.Path ? "row-selected" : "clickable")"
                            @onclick="() => SelectConfig(cfg.Path)">
                            <td class="mono small">@cfg.Path</td>
                            <td>
                                @if (cfg.Error is not null)
                                {
                                    <span class="text-danger" title="@cfg.Error">doesn't load</span>
                                }
                                else
                                {
                                    @cfg.Name
                                }
                            </td>
                            <td class="muted small">@(cfg.Error is null ? string.Join(", ", cfg.Agents) : "—")</td>
                            <td class="muted">@cfg.SelectionType</td>
                            <td>
                                <button class="btn btn-sm" @onclick:stopPropagation
                                        @onclick="() => ValidateConfigAsync(cfg.Path)">
                                    Validate
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@if (_validating)
{
    <p class="muted">Validating…</p>
}
else if (_validation is not null)
{
    <div class="config-validate-panel">
        <div class="config-validate-header">
            <h2>@(_validation.Config?.Name ?? "Validation") — @(_validation.Valid ? "✓ Valid" : "✗ Invalid")</h2>
            <span class="muted small">@_validation.Path</span>
        </div>

        @if (_validation.Config is { } s)
        {
            <div class="config-details">
                @if (!string.IsNullOrWhiteSpace(s.Description))
                {
                    <p class="muted">@s.Description</p>
                }
                <div class="config-agents">
                    @foreach (var a in s.Agents)
                    {
                        <span class="agent-chip">@a</span>
                    }
                </div>
                <p class="muted small">Selection: <strong>@s.SelectionType</strong></p>
            </div>
        }

        @if (_validation.Issues.Count == 0)
        {
            <p class="text-success">No issues found.</p>
        }
        else
        {
            <ul class="issue-list">
                @foreach (var issue in _validation.Issues)
                {
                    <li class="issue-@issue.Level">
                        <span class="issue-icon">@(issue.Level == "error" ? "✗" : "⚠")</span>
                        @issue.Message
                    </li>
                }
            </ul>
        }
    </div>
}

@code {
    private string  _path       = string.Empty;
    private bool    _showPicker = false;

    protected override void OnInitialized()
    {
        _path = PreferFuseraftConfigDir(WorkspaceService.Current);
        WorkspaceService.Changed += OnWorkspaceChanged;
    }

    private void OnWorkspaceChanged() =>
        InvokeAsync(() => { _path = PreferFuseraftConfigDir(WorkspaceService.Current); StateHasChanged(); });

    private static string PreferFuseraftConfigDir(string workspace)
    {
        if (string.IsNullOrWhiteSpace(workspace)) return workspace;
        var sub = Path.Combine(workspace, ".fuseraft", "config");
        return Directory.Exists(sub) ? sub : workspace;
    }

    public void Dispose() => WorkspaceService.Changed -= OnWorkspaceChanged;
    private bool    _scanning   = false;
    private bool    _validating = false;
    private string? _error;

    private List<WireConfigSummary>? _configs    = null;
    private WireConfigSummary?       _selected   = null;
    private WireValidation?          _validation = null;

    private void TogglePicker() { _showPicker = !_showPicker; }

    private async Task OnDirSelected(string path)
    {
        _path       = path;
        _showPicker = false;
        WorkspaceService.Set(path);
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_path)) return;
        var trimmed = _path.Trim();
        WorkspaceService.Set(trimmed);

        _scanning   = true;
        _error      = null;
        _validation = null;
        _selected   = null;
        StateHasChanged();

        try
        {
            if (File.Exists(trimmed))
            {
                await ValidateConfigAsync(trimmed);
                _configs = [_validation?.Config ?? new WireConfigSummary { Path = Path.GetFullPath(trimmed), Error = "Doesn't load." }];
                _selected = _configs[0];
            }
            else
            {
                _configs = await ConfigService.ListConfigsAsync(trimmed);
            }
        }
        catch (FuseraftCliException ex)
        {
            _configs = null;
            _error   = ex.Message;
        }
        finally { _scanning = false; StateHasChanged(); }
    }

    private void SelectConfig(string path)
    {
        _selected = _configs?.FirstOrDefault(c => c.Path == path);
        StateHasChanged();
    }

    private async Task ValidateConfigAsync(string path)
    {
        _validating = true;
        _error      = null;
        StateHasChanged();
        try
        {
            _validation = await ConfigService.ValidateAsync(path);
            _selected   = _configs?.FirstOrDefault(c => c.Path == path);
        }
        catch (FuseraftCliException ex) { _validation = null; _error = ex.Message; }
        finally { _validating = false; StateHasChanged(); }
    }
}
