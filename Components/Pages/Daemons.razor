@page "/daemons"
@implements IDisposable
@inject DaemonService DaemonService
@inject HitlBroker Broker
@inject UserStore Users

<PageTitle>Daemons — Fuseraft</PageTitle>

<div class="page-header">
    <h1>Daemons</h1>
    @if (IsAdmin)
    {
        <button class="btn btn-primary" @onclick="OpenAdd">+ Add Daemon</button>
    }
</div>

<p class="muted" style="margin-bottom:16px">
    Attach to a running <code>fuseraft serve</code> over its WebSocket to send it tasks, watch its progress
    and answer its approvals.
</p>

@if (_showAdd)
{
    <div class="dialog-backdrop" @onclick="CloseAdd">
        <div class="dialog" @onclick:stopPropagation>
            <div class="dialog-header">
                <h2>Add Daemon</h2>
                <button class="btn-icon" @onclick="CloseAdd">✕</button>
            </div>
            <div class="form-group">
                <label class="form-label">Name</label>
                <input @bind="_addName" class="input" placeholder="build-box" />
            </div>
            <div class="form-group">
                <label class="form-label">Attach URL</label>
                <input @bind="_addUrl" @bind:event="oninput" class="input" placeholder="wss://build-box.lan:24601/attach" />
                <p class="form-hint"><code>fuseraft serve</code> prints it as "Attach WebSocket".</p>
                @if (new DaemonEndpoint { Url = _addUrl.Trim() }.Unencrypted)
                {
                    <p class="form-hint text-warn">⚠ ws:// to another machine is unencrypted: the token and every task can be read
                        on the network. Start the daemon with <code>--tls-cert</code> and use wss://.</p>
                }
            </div>
            <div class="form-group">
                <label class="form-label">Token <span class="form-optional">(optional)</span></label>
                <input @bind="_addToken" class="input" type="password" autocomplete="off" />
                <p class="form-hint">The daemon's <code>FUSERAFT_SERVE_TOKEN</code>. Saved encrypted in this server's data directory.</p>
            </div>
            <div class="form-group">
                <label class="form-label">Certificate SHA-256 <span class="form-optional">(optional)</span></label>
                <input @bind="_addPin" class="input mono" autocomplete="off" placeholder="3A:9F:…" />
                <p class="form-hint">For a self-signed certificate: the fingerprint <code>fuseraft serve --tls-cert</code> prints.
                    Leave it empty for a certificate from a CA this server trusts.</p>
            </div>
            @if (_addError is not null)
            {
                <div class="error-banner">@_addError</div>
            }
            <div class="dialog-footer">
                <button class="btn" @onclick="CloseAdd">Cancel</button>
                <button class="btn btn-primary" @onclick="AddAsync">Add and Connect</button>
            </div>
        </div>
    </div>
}

@if (_connections.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">⇄</div>
        @if (IsAdmin)
        {
            <p>No daemons yet.</p>
            <p class="muted">Start one with <code>fuseraft serve</code>, then add its attach URL here.</p>
        }
        else
        {
            <p>No daemons have been shared with you.</p>
            <p class="muted">An admin can give you access to one from this page.</p>
        }
    </div>
}
else
{
    <table class="data-table" style="margin-bottom:24px">
        <thead>
            <tr><th>Name</th><th>URL</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var c in _connections)
            {
                <tr class="clickable" @key="c.Id" @onclick="() => Select(c.Id)"
                    style="@(c.Id == _selected ? "background:var(--surface2)" : "")">
                    <td><strong>@c.Endpoint.Name</strong></td>
                    <td class="mono small">
                        @c.Endpoint.Url
                        @if (c.ReadOnly)
                        {
                            <span class="status-badge badge-muted" title="This server's token for the daemon can watch, but not send tasks.">read-only</span>
                        }
                        @if (c.Endpoint.Unencrypted)
                        {
                            <span class="status-badge badge-warn" title="The token and every task travel unencrypted. Use --tls-cert and wss://.">unencrypted</span>
                        }
                    </td>
                    <td>
                        <span class="status-badge @BadgeClass(c)">@BadgeLabel(c)</span>
                        @if (c.State is DaemonState.Disconnected or DaemonState.Reconnecting && c.Error is not null)
                        {
                            <div class="muted small">@c.Error</div>
                        }
                    </td>
                    <td class="nowrap" @onclick:stopPropagation>
                        @if (IsAdmin && c.State is DaemonState.Disconnected or DaemonState.Reconnecting)
                        {
                            <button class="btn btn-sm" @onclick="() => ConnectAsync(c)">@(c.State == DaemonState.Reconnecting ? "Retry now" : "Connect")</button>
                        }
                        @if (IsAdmin && c.State != DaemonState.Disconnected)
                        {
                            <button class="btn btn-sm" @onclick="() => DaemonService.DisconnectAsync(c)">Disconnect</button>
                        }
                        @if (IsAdmin && !c.Configured)
                        {
                            <button class="btn btn-sm btn-danger" @onclick="() => DaemonService.RemoveAsync(c.Id)">Remove</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (Selected is { } d)
{
    <h2 style="margin-bottom:12px">@d.Endpoint.Name</h2>

    @if (d.State == DaemonState.Connected && !d.SupportsReconnect)
    {
        <div class="error-banner">This daemon runs a fuseraft older than v1.14.0. If the connection drops, a pending approval
            is decided by its <code>--unattended-policy</code> and results that finish meanwhile are lost. Upgrade fuseraft
            on the daemon's machine.</div>
    }

    @if (IsAdmin)
    {
        <div class="form-group">
            <label class="form-label">Who else may use it</label>
            @if (d.Configured)
            {
                <p class="form-hint">@(d.Endpoint.Users.Count == 0 ? "Admins only." : string.Join(", ", d.Endpoint.Users))
                    Set <code>Users</code> for it in <code>Fuseraft:Daemons</code> to change this.</p>
            }
            else
            {
                <input class="input" @bind="_usersText" placeholder="alice, bob" />
                <p class="form-hint">Usernames of non-admins who may send it tasks and answer their own tasks' approvals.
                    Each sees only their own tasks, but the activity feed shows every task's progress. Admins always may.</p>
                @if (_usersError is not null) { <div class="error-banner">@_usersError</div> }
                <button class="btn btn-sm" @onclick="() => SaveUsers(d)">Save access</button>
            }
        </div>
    }

    @foreach (var req in _approvals)
    {
        <ApprovalCard @key="req.Id" Request="req" ShowSource="false" />
    }

    @if (d.ReadOnly)
    {
        <p class="muted">This server's token for the daemon is read-only, so you can follow its progress here but not send
            it tasks. The daemon's <code>--tokens-file</code> gives a token full access without <code>read</code> after it.</p>
    }
    else
    {
    <div class="form-group">
        <label class="form-label">Task</label>
        <textarea @bind="_task" @bind:event="oninput" rows="3" class="input" disabled="@(d.State != DaemonState.Connected)"
                  placeholder="What should the daemon's team do?"></textarea>
        @if (d.State == DaemonState.Connected && !d.CanDispatch)
        {
            <p class="form-hint">Waiting for the last task sent from this server to finish. The daemon takes one task at a time from each connection.</p>
        }
    </div>
    @if (_dispatchError is not null)
    {
        <div class="error-banner">@_dispatchError</div>
    }
    <button class="btn btn-primary" @onclick="() => DispatchAsync(d)"
            disabled="@(!d.CanDispatch || string.IsNullOrWhiteSpace(_task))">Send Task</button>
    }

    @if (d.TasksFor(Current.User) is { Count: > 0 } tasks)
    {
        <div class="orch-section-label" style="margin-top:24px; margin-bottom:8px">@(IsAdmin ? "Tasks from this server" : "Your tasks")</div>
        <table class="data-table">
            <thead>
                <tr><th>Session</th><th>Task</th><th>Status</th><th>Result</th></tr>
            </thead>
            <tbody>
                @foreach (var t in tasks)
                {
                    <tr @key="t.SessionId">
                        <td class="id-cell">@t.SessionId</td>
                        <td>@t.Task</td>
                        <td class="nowrap"><span class="status-badge @TaskBadgeClass(t)">@TaskLabel(t)</span></td>
                        <td>
                            @if (t.ErrorMessage is not null) { <div class="muted small">@t.ErrorMessage</div> }
                            @if (t.LastMessage is not null)
                            {
                                <div class="small">@(t.LastAgent is null ? "" : $"{t.LastAgent}: ")@t.LastMessage</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="orch-section-label" style="margin-top:24px; margin-bottom:8px">Activity <span class="muted small">(every client's tasks)</span></div>
    <div class="live-feed">
        @if (d.Activity.Count == 0)
        {
            <div class="feed-empty muted">Nothing yet.</div>
        }
        @foreach (var a in d.Activity.Reverse().Take(100))
        {
            <div class="small"><span class="muted mono">@a.At.LocalDateTime.ToString("HH:mm:ss")</span> @a.Text</div>
        }
    </div>
}

@code {
    private List<DaemonConnection> _connections = [];
    private List<PendingApproval> _approvals = [];
    private Guid?   _selected;
    private string  _task = string.Empty;
    private string? _dispatchError;

    private bool    _showAdd;
    private string  _addName  = string.Empty;
    private string  _addUrl   = string.Empty;
    private string  _addToken = string.Empty;
    private string  _addPin   = string.Empty;
    private string? _addError;

    private string  _usersText = string.Empty;
    private string? _usersError;

    private bool IsAdmin => Current.User.IsAdmin;

    private DaemonConnection? Selected =>
        _selected is { } id && DaemonService.Get(id) is { } c && c.Endpoint.Allows(Current.User) ? c : null;

    protected override void OnInitialized()
    {
        DaemonService.Changed       += OnChanged;
        Broker.PendingChanged += OnChanged;
        Refresh();
        Select(_connections.FirstOrDefault()?.Id);
    }

    private void Select(Guid? id)
    {
        _selected   = id;
        _usersError = null;
        Refresh();
        _usersText = Selected is { } d ? string.Join(", ", d.Endpoint.Users) : string.Empty;
    }

    private void SaveUsers(DaemonConnection d)
    {
        if (!IsAdmin) return;
        var names   = _usersText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var unknown = names.Where(n => Users.FindByName(n) is null).ToList();
        if (unknown.Count > 0)
        {
            _usersError = $"No account named {string.Join(", ", unknown.Select(n => $"'{n}'"))}.";
            return;
        }
        _usersError = null;
        DaemonService.SetUsers(d, names);
    }

    private void Refresh()
    {
        foreach (var c in _connections) c.Changed -= OnChanged;
        _connections = [.. DaemonService.For(Current.User)];
        foreach (var c in _connections) c.Changed += OnChanged;
        if (_selected is { } id && _connections.All(c => c.Id != id)) _selected = _connections.FirstOrDefault()?.Id;
        var name = Selected?.Endpoint.Name;
        _approvals = [.. Broker.GetPending(Current.User).Where(p => p.Source == ApprovalSource.Daemon && p.Origin == name)];
    }

    private void OnChanged() => InvokeAsync(() => { Refresh(); StateHasChanged(); });

    private void OpenAdd()
    {
        _showAdd  = true;
        _addError = null;
        _addName  = _addUrl = _addToken = _addPin = string.Empty;
    }

    private void CloseAdd() => _showAdd = false;

    private async Task AddAsync()
    {
        if (!IsAdmin) return;
        if (DaemonService.Validate(_addName, _addUrl, _addPin) is { } problem)
        {
            _addError = problem;
            return;
        }
        var connection = DaemonService.Add(_addName, _addUrl, _addToken, _addPin);
        _addToken = string.Empty;
        _showAdd  = false;
        Select(connection.Id);
        await DaemonService.ConnectAsync(connection);
    }

    private async Task ConnectAsync(DaemonConnection c)
    {
        if (!IsAdmin) return;
        Select(c.Id);
        await DaemonService.ConnectAsync(c);
    }

    private async Task DispatchAsync(DaemonConnection d)
    {
        _dispatchError = null;
        try
        {
            await d.DispatchAsync(_task.Trim(), Current.User.Id);
            _task = string.Empty;
        }
        catch (Exception ex) { _dispatchError = ex.Message; }
    }

    private static string BadgeLabel(DaemonConnection c) => c.State switch
    {
        DaemonState.Connected    => "● Connected",
        DaemonState.Connecting   => "● Connecting",
        DaemonState.Reconnecting => c.NextAttempt is { } at
            ? $"↻ Retrying at {at.LocalDateTime:HH:mm:ss}"
            : "↻ Reconnecting",
        _                        => c.Error is null ? "Disconnected" : "✗ Disconnected",
    };

    private static string BadgeClass(DaemonConnection c) => c.State switch
    {
        DaemonState.Connected    => "badge-ok",
        DaemonState.Connecting   => "badge-blue badge-pulse",
        DaemonState.Reconnecting => "badge-warn",
        _                        => c.Error is null ? "badge-muted" : "badge-err",
    };

    private static string TaskLabel(DaemonTask t) => t.Status switch
    {
        DaemonTaskStatus.Queued       => "● In progress",
        DaemonTaskStatus.Succeeded    => "✓ Complete",
        DaemonTaskStatus.Failed       => "✗ Failed",
        DaemonTaskStatus.Reconnecting => "↻ Reconnecting",
        _                             => "? Lost",
    };

    private static string TaskBadgeClass(DaemonTask t) => t.Status switch
    {
        DaemonTaskStatus.Queued       => "badge-blue badge-pulse",
        DaemonTaskStatus.Succeeded    => "badge-ok",
        DaemonTaskStatus.Failed       => "badge-err",
        DaemonTaskStatus.Reconnecting => "badge-warn",
        _                             => "badge-muted",
    };

    public void Dispose()
    {
        DaemonService.Changed       -= OnChanged;
        Broker.PendingChanged -= OnChanged;
        foreach (var c in _connections) c.Changed -= OnChanged;
    }
}
