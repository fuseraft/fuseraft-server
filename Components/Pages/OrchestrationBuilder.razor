@page "/orchestration/builder"
@implements IDisposable
@inject OrchestrationTemplateService TemplateService
@inject NavigationManager Nav
@inject WorkspaceService WorkspaceService
@inject ModelProfileService ProfileService
@inject ConfigService ConfigService
@inject SessionHostService SessionHostService

<PageTitle>Orchestration Builder — Fuseraft</PageTitle>

<div class="page-header">
    <h1>Orchestration Builder</h1>
</div>

<div class="builder-steps">
    <div class="builder-step @(_step > 1 ? "done" : "active")">1. Template</div>
    <div class="builder-step @(_step >= 2 ? "active" : "")">2. Generate</div>
</div>

@if (_error is not null)
{
    <div class="error-banner">@_error</div>
}

@if (_step == 1)
{
    @if (_recentConfigs.Count > 0)
    {
        <div class="orch-section-label" style="margin-bottom:10px">Recent</div>
        <div class="template-grid">
            @foreach (var (path, workspace) in _recentConfigs)
            {
                <button class="template-card @(_selectedRecent == path ? "selected" : "")"
                        @onclick="() => SelectRecent(path, workspace)">
                    <div class="template-card-name">@Path.GetFileName(path)</div>
                    <div class="template-card-desc saved-config-path">@path</div>
                </button>
            }
        </div>
        <div class="orch-section-label" style="margin-top:24px; margin-bottom:10px">Templates</div>
    }
    else
    {
        <p class="muted" style="margin-bottom:20px">Pick a team template. <code>fuseraft init</code> generates the config from it.</p>
    }

    @if (_templates is null)
    {
        <p class="muted">Loading templates…</p>
    }
    else
    {
        <div class="template-grid">
            @foreach (var t in _templates)
            {
                <button class="template-card @(_selectedKey == t.Key ? "selected" : "")"
                        @onclick="() => SelectTemplate(t.Key)">
                    <div class="template-card-name">@t.Label</div>
                    <div class="template-card-desc">@t.Description</div>
                    <div class="template-card-agents"><span class="template-card-selection-badge">@t.Key</span></div>
                </button>
            }
        </div>
    }
    <div style="margin-top:24px; display:flex; gap:10px;">
        <button class="btn btn-primary" @onclick="() => _step = 2" disabled="@(_selectedKey is null && _selectedRecent is null)">Next →</button>
        <a href="/sessions" class="btn">Cancel</a>
    </div>
}

@if (_step == 2)
{
    <div class="orch-canvas-section">
        <div style="min-width:0;">
            @if (_selectedRecent is not null)
            {
                <div class="orch-section-label">Config</div>
                <p class="mono small" style="word-break:break-all;">@_selectedRecent</p>
            }
            else if (_generated is null)
            {
                <div class="orch-section-label">Template</div>
                <p><strong>@SelectedTemplate?.Label</strong></p>
                <p class="muted">@SelectedTemplate?.Description</p>
                <p class="form-hint">Generating writes the config and its agent files, and sets up <code>.fuseraft/</code> in the workspace. Edit the files afterwards to customise agents.</p>
            }
            else
            {
                <div class="orch-section-label">Generated</div>
                <p class="mono small" style="word-break:break-all;">@_generated.ConfigPath</p>
                @if (_generated.AgentFiles.Count > 0)
                {
                    <ul class="muted small">
                        @foreach (var f in _generated.AgentFiles) { <li class="mono">@f</li> }
                    </ul>
                }
                @if (_validation is not null)
                {
                    <p>@(_validation.Valid ? "✓ Valid" : "✗ Invalid")
                        @if (_validation.Config is { } c)
                        {
                            <span class="muted small"> — @string.Join(" → ", c.Agents) (@c.SelectionType)</span>
                        }
                    </p>
                    @if (_validation.Issues.Count > 0)
                    {
                        <ul class="issue-list">
                            @foreach (var issue in _validation.Issues)
                            {
                                <li class="issue-@issue.Level">
                                    <span class="issue-icon">@(issue.Level == "error" ? "✗" : "⚠")</span>
                                    @issue.Message
                                </li>
                            }
                        </ul>
                    }
                }
                <textarea class="orch-yaml-editor" readonly>@_generatedYaml</textarea>
            }
        </div>

        <div class="orch-side-panel">
            <div class="form-group">
                <label class="form-label">Workspace</label>
                <div class="input-with-btn">
                    <input class="input" @bind="_workspace" placeholder="/home/user/myproject" disabled="@(_generated is not null)" />
                    <button class="btn btn-sm" @onclick="TogglePicker" disabled="@(_generated is not null)">Browse…</button>
                </div>
                @if (_showDirPicker)
                {
                    <DirPicker InitialPath="@_workspace" OnSelect="OnDirSelected" OnClose="ClosePicker" />
                }
            </div>

            @if (_selectedRecent is null && _generated is null)
            {
                <div class="form-group">
                    <label class="form-label">Config File</label>
                    <input class="input" @bind="_configRelPath" placeholder=".fuseraft/config/orchestration.yaml" />
                    @if (!string.IsNullOrWhiteSpace(_workspace) && !string.IsNullOrWhiteSpace(_configRelPath)
                         && !Path.IsPathRooted(_configRelPath))
                    {
                        <p class="orch-save-path">→ @Path.Combine(_workspace.Trim(), _configRelPath.Trim())</p>
                    }
                </div>
                <div class="form-group">
                    <label class="form-label">Model <span class="form-optional">(optional)</span></label>
                    <input class="input" @bind="_model" list="builder-models" placeholder="Detected from your API keys" />
                    <datalist id="builder-models">
                        @foreach (var p in _profiles) { <option value="@p.ModelId">@p.Name</option> }
                    </datalist>
                </div>
                <div class="form-group">
                    <label class="form-label">Endpoint <span class="form-optional">(optional)</span></label>
                    <input class="input" @bind="_endpoint" placeholder="From ~/.fuseraft/config" />
                </div>
                <label class="small"><input type="checkbox" @bind="_force" /> Overwrite existing files</label>
            }

            <div class="orch-builder-actions">
                @if (_generated is null)
                {
                    <button class="btn" @onclick="Back">← Back</button>
                }
                @if (_selectedRecent is null && _generated is null)
                {
                    <button class="btn btn-primary" @onclick="GenerateAsync" disabled="@_busy">
                        @(_busy ? "Generating…" : "Generate")
                    </button>
                }
                else
                {
                    <button class="btn btn-primary" @onclick="StartSession">Start Session</button>
                }
                @if (_generated is not null)
                {
                    <a href="/configs" class="btn">Done</a>
                }
            </div>
        </div>
    </div>
}

@code {
    private int                 _step = 1;
    private List<WireTemplate>? _templates;
    private string?             _selectedKey;
    private string?             _selectedRecent;
    private List<(string Path, string? Workspace)> _recentConfigs = [];
    private IReadOnlyList<ModelProfile> _profiles = [];

    private string  _workspace     = string.Empty;
    private string  _configRelPath = ".fuseraft/config/orchestration.yaml";
    private string  _model         = string.Empty;
    private string  _endpoint      = string.Empty;
    private bool    _force;
    private bool    _showDirPicker;
    private bool    _busy;
    private string? _error;

    private WireInitResult? _generated;
    private WireValidation? _validation;
    private string          _generatedYaml = string.Empty;

    private WireTemplate? SelectedTemplate => _templates?.FirstOrDefault(t => t.Key == _selectedKey);

    protected override async Task OnInitializedAsync()
    {
        _workspace = WorkspaceService.Current;
        WorkspaceService.Changed += OnWorkspaceChanged;
        _profiles = await ProfileService.ListAsync();
        _recentConfigs = SessionHostService.GetSessions()
            .Where(s => !string.IsNullOrEmpty(s.ConfigPath) && File.Exists(s.ConfigPath))
            .DistinctBy(s => s.ConfigPath, StringComparer.OrdinalIgnoreCase)
            .Take(10)
            .Select(s => (s.ConfigPath, s.WorkingDirectory))
            .ToList();
        try { _templates = await TemplateService.ListAsync(); }
        catch (FuseraftCliException ex) { _templates = []; _error = ex.Message; }
    }

    private void OnWorkspaceChanged() =>
        InvokeAsync(() =>
        {
            if (string.IsNullOrWhiteSpace(_workspace))
            {
                _workspace = WorkspaceService.Current;
                StateHasChanged();
            }
        });

    public void Dispose() => WorkspaceService.Changed -= OnWorkspaceChanged;

    private void SelectTemplate(string key) { _selectedKey = key; _selectedRecent = null; }

    private void SelectRecent(string path, string? workspace)
    {
        _selectedRecent = path;
        _selectedKey    = null;
        if (!string.IsNullOrWhiteSpace(workspace)) _workspace = workspace;
    }

    private void Back() { _step = 1; _error = null; }

    private async Task GenerateAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_workspace))     { _error = "Workspace is required."; return; }
        if (!Directory.Exists(_workspace.Trim()))      { _error = $"Workspace not found: {_workspace.Trim()}"; return; }
        if (string.IsNullOrWhiteSpace(_configRelPath)) { _error = "Config file path is required."; return; }
        if (_selectedKey is null) return;

        _busy = true;
        StateHasChanged();
        try
        {
            var ws = _workspace.Trim();
            WorkspaceService.Set(ws);
            _generated     = await TemplateService.GenerateAsync(ws, _selectedKey, _configRelPath.Trim(), _model.Trim(), _endpoint.Trim(), _force);
            _generatedYaml = await File.ReadAllTextAsync(_generated.ConfigPath);
            _validation    = await ConfigService.ValidateAsync(_generated.ConfigPath);
        }
        catch (FuseraftCliException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void StartSession()
    {
        if (string.IsNullOrWhiteSpace(_workspace)) { _error = "Workspace is required."; return; }
        var cfg = _generated?.ConfigPath ?? _selectedRecent;
        if (cfg is null) return;
        Nav.NavigateTo($"/sessions?workspace={Uri.EscapeDataString(_workspace.Trim())}&config={Uri.EscapeDataString(cfg)}&new=true");
    }

    private void TogglePicker()  => _showDirPicker = !_showDirPicker;
    private void ClosePicker()   => _showDirPicker = false;
    private void OnDirSelected(string path) { _workspace = path; _showDirPicker = false; WorkspaceService.Set(path); }
}
