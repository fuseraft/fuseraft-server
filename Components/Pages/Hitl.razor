@page "/hitl"
@implements IDisposable
@inject HitlBroker Broker

<PageTitle>HITL — Fuseraft</PageTitle>

<div class="page-header">
    <h1>Human-in-the-Loop</h1>
    @if (_pending.Count > 0)
    {
        <span class="count-badge">@_pending.Count pending</span>
    }
</div>

@if (_pending.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">✓</div>
        <p>No pending approvals.</p>
        <p class="muted">Sessions, REPL chats and tasks sent to daemons ask here before they run a command, write a file,
           or hand off between agents.</p>
    </div>
}
else
{
    @foreach (var req in _pending)
    {
        <ApprovalCard @key="req.Id" Request="req" />
    }
}

@code {
    private List<PendingApproval> _pending = [];

    protected override void OnInitialized()
    {
        _pending = [..Broker.GetPending()];
        Broker.PendingChanged += OnPendingChanged;
    }

    private void OnPendingChanged() =>
        InvokeAsync(() => { _pending = [..Broker.GetPending()]; StateHasChanged(); });

    public void Dispose() => Broker.PendingChanged -= OnPendingChanged;
}
